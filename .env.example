# ==============================================================================
# WEB APPLICATION ENVIRONMENT VARIABLES
# ==============================================================================

# API Base URL for HTTP requests
# Local development
VITE_API_BASE_URL=http://localhost:8090/api/v1

# Production (update with your Render backend URL)
# VITE_API_BASE_URL=https://server-o9xh.onrender.com/api/v1

# WebSocket Base URL for real-time features (Yjs collaborative editing & notifications)
# Local development
VITE_WS_BASE_URL=ws://localhost:8090

# Optional. Where the Mollama desktop app can be downloaded. When set, the Devices page shows a download button.
VITE_DESKTOP_DOWNLOAD_URL=

# Production (update with your Render backend URL - note wss:// for secure WebSocket)
# VITE_WS_BASE_URL=wss://server-o9xh.onrender.com
